# 셀프호스팅 Supabase (미니PC) — Coolify 환경변수에 입력
SUPABASE_URL=https://api-travel.jawsweb.site
SUPABASE_ANON_KEY=
# 정정 요청 기록용 (서버 전용, 브라우저에 노출되지 않음)
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_BRAND=Travel.with.Jaws
NEXT_PUBLIC_SITE_URL=https://travel.jawsweb.site
# (선택) 히어로 배경 영상 — 권리 승인된 영상의 공개 주소만
HERO_VIDEO_URL=
HERO_VIDEO_POSTER=

# 편집 콘솔 (/console) 로그인. 비어 있으면 콘솔은 404
# 형식: 이름:비밀번호:staff_uuid  (여러 명은 ; 로 구분, staff_uuid 는 trip.staff 의 id)
CONSOLE_USERS=
